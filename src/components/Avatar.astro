---
// Ilustración de Sarahi con parpadeo animado
---
<svg class="avatar-svg" viewBox="0 0 200 200" role="img" aria-label="Ilustración de Sarahi">
  <defs>
    <linearGradient id="av-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#60a5fa" />
      <stop offset="1" stop-color="#1d4ed8" />
    </linearGradient>
    <linearGradient id="av-hood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff7aa2" />
      <stop offset="1" stop-color="#e2457a" />
    </linearGradient>
    <clipPath id="av-clip"><rect width="200" height="200" rx="44" /></clipPath>
  </defs>
  <g clip-path="url(#av-clip)">
    <rect width="200" height="200" fill="url(#av-bg)" />
    <g fill="#fff" opacity=".7">
      <path d="M30 40l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" />
      <path d="M168 30l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
      <circle cx="165" cy="78" r="2" />
      <circle cx="28" cy="110" r="2.5" />
    </g>
    <path d="M56 92Q54 36 100 36t44 56l6 72q-50 18-100 0z" fill="#2b1b24" />
    <path d="M34 210q4-60 66-64 62 4 66 64z" fill="url(#av-hood)" />
    <path d="M74 150q26 16 52 0" stroke="#c42f60" stroke-width="4" fill="none" stroke-linecap="round" />
    <path d="M90 158v22M110 158v22" stroke="#fff" stroke-width="3" stroke-linecap="round" />
    <circle cx="90" cy="182" r="3" fill="#fff" /><circle cx="110" cy="182" r="3" fill="#fff" />
    <rect x="91" y="124" width="18" height="26" rx="8" fill="#e9b184" />
    <ellipse cx="100" cy="98" rx="38" ry="42" fill="#f5c99b" />
    <ellipse cx="62" cy="102" rx="6" ry="9" fill="#e9b184" />
    <ellipse cx="138" cy="102" rx="6" ry="9" fill="#e9b184" />
    <path d="M60 92q2-44 40-44t40 44q-14-22-34-20-6 10-22 10 4-6 4-10-14 4-28 20z" fill="#2b1b24" />
    <g class="av-eyes">
      <ellipse cx="85" cy="102" rx="5" ry="6.5" fill="#2b1b24" />
      <ellipse cx="115" cy="102" rx="5" ry="6.5" fill="#2b1b24" />
      <circle cx="87" cy="99.5" r="1.8" fill="#fff" />
      <circle cx="117" cy="99.5" r="1.8" fill="#fff" />
    </g>
    <path d="M78 91q7-4 13 0M109 91q7-4 13 0" stroke="#2b1b24" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <ellipse cx="74" cy="115" rx="7" ry="4.5" fill="#ff8fb1" opacity=".7" />
    <ellipse cx="126" cy="115" rx="7" ry="4.5" fill="#ff8fb1" opacity=".7" />
    <path d="M91 117q9 9 18 0" stroke="#2b1b24" stroke-width="3" fill="#c42f60" stroke-linecap="round" stroke-linejoin="round" />
    <g transform="translate(130 58) rotate(20)">
      <path d="M0-10l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" fill="#fcd34d" stroke="#f59e0b" stroke-width="1.5" />
    </g>
  </g>
</svg>

<style>
  .avatar-svg { display: block; width: 100%; height: auto; }
  .av-eyes { transform-origin: 100px 102px; animation: blink 5s infinite; }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
</style>
