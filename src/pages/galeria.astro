---
import Layout from '../layouts/Layout.astro';
import Michi from '../components/Michi.astro';
const base = import.meta.env.BASE_URL;

const filtros = [
  { id: 'todos', label: 'Todos', icon: '✨' },
  { id: 'dia', label: 'De día', icon: '☀️' },
  { id: 'noche', label: 'De noche', icon: '🌙' },
];
const obras = [
  { src: 'montanas.svg', title: 'Montañas al amanecer', desc: 'Un lago tranquilo y el sol despertando (igual que yo, lento).', cat: 'dia', big: true },
  { src: 'playa.svg', title: 'Playa al atardecer', desc: 'Palmeras, arena y el mar pintado de rosa.', cat: 'dia' },
  { src: 'ciudad.svg', title: 'Ciudad de noche', desc: 'Mil ventanitas encendidas mientras todos duermen.', cat: 'noche' },
  { src: 'espacio.svg', title: 'Viaje al espacio', desc: 'Un cohete rumbo a un planeta donde siempre es hora de la siesta.', cat: 'noche', big: true },
  { src: 'flores.svg', title: 'Campo de flores', desc: 'Primavera, abejitas y mariposas.', cat: 'dia', wide: true },
];
---
<Layout title="Galería" description="Galería de dibujos de Sarahi: paisajes, la ciudad de noche, el espacio y Michi.">
  <header class="page-head">
    <span class="kicker reveal">🎨 Mis dibujos</span>
    <h1 class="reveal" style="--d:.06s">La <span class="grad-text">galería</span></h1>
    <p class="section-sub reveal" style="--d:.12s">Dale clic a cualquier dibujo para verlo en grande.</p>
    <div class="filters reveal" style="--d:.18s" role="group" aria-label="Filtrar dibujos">
      {filtros.map((f, i) => (
        <button type="button" class="chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span aria-hidden="true">{f.icon}</span> {f.label}
        </button>
      ))}
    </div>
  </header>

  <ul class="masonry">
    {obras.map((o, i) => (
      <li class:list={['tile', 'reveal', { big: o.big, wide: o.wide }]} data-cat={o.cat} style={`--d:${i * 0.07}s`}>
        <button type="button" class="open" data-index={i} aria-label={`Ver ${o.title} en grande`}>
          <img src={`${base}img/${o.src}`} alt={o.title} width="800" height="520" loading="lazy" decoding="async" />
          <span class="overlay">
            <b>{o.title}</b>
            <small>{o.desc}</small>
          </span>
          <span class="zoom" aria-hidden="true">⤢</span>
        </button>
      </li>
    ))}
  </ul>

  <section class="feature">
    <div class="card michi-card reveal">
      <Michi />
      <p class="caption"><strong>Figura 1.</strong> Michi, la mascota del grupo. Mueve el mouse: ¡te está viendo! 👀</p>
    </div>

    <div class="card promo reveal" style="--d:.1s">
      <div class="phone" aria-hidden="true">
        <div class="notch"></div>
        <div class="screen">
          <span class="apple"></span>
          <b>iPhone 18</b>
          <small>Nuevo. Brillante. Carísimo.</small>
        </div>
      </div>
      <p>Haz clic en el logo para visitar Apple y que te compres el <strong>iPhone 18</strong> 📱</p>
      <a class="logo" href="https://www.apple.com/mx/" target="_blank" rel="noopener" aria-label="Visitar Apple (se abre en otra pestaña)">
        <img src={`${base}img/web-logo.svg`} alt="" width="96" height="96" />
        <span class="pulse" aria-hidden="true"></span>
      </a>
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Visor de dibujos">
    <button type="button" class="lb-close" aria-label="Cerrar">✕</button>
    <button type="button" class="lb-nav prev" aria-label="Anterior">‹</button>
    <figure>
      <img id="lb-img" src="" alt="" width="800" height="520" />
      <figcaption><b id="lb-title"></b><span id="lb-desc"></span><small id="lb-count"></small></figcaption>
    </figure>
    <button type="button" class="lb-nav next" aria-label="Siguiente">›</button>
  </dialog>
</Layout>

<script define:vars={{ obras, base }}>
  const dlg = document.getElementById('lightbox');
  const img = document.getElementById('lb-img');
  const title = document.getElementById('lb-title');
  const desc = document.getElementById('lb-desc');
  const count = document.getElementById('lb-count');
  let visible = obras.map((_, i) => i);
  let pos = 0;

  const show = (p) => {
    pos = (p + visible.length) % visible.length;
    const o = obras[visible[pos]];
    img.src = base + 'img/' + o.src;
    img.alt = o.title;
    title.textContent = o.title;
    desc.textContent = o.desc;
    count.textContent = `${pos + 1} / ${visible.length}`;
    img.animate([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: 'ease-out' });
  };

  document.querySelectorAll('.open').forEach((b) =>
    b.addEventListener('click', () => {
      show(visible.indexOf(Number(b.dataset.index)));
      dlg.showModal();
    })
  );
  dlg.querySelector('.lb-close').addEventListener('click', () => dlg.close());
  dlg.querySelector('.prev').addEventListener('click', () => show(pos - 1));
  dlg.querySelector('.next').addEventListener('click', () => show(pos + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(pos - 1);
    if (e.key === 'ArrowRight') show(pos + 1);
  });
  let x0 = null;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(pos + (dx < 0 ? 1 : -1));
    x0 = null;
  });

  // Filtros
  const chips = document.querySelectorAll('.chip');
  const tiles = document.querySelectorAll('.tile');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const f = c.dataset.filter;
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      visible = [];
      tiles.forEach((t, i) => {
        const on = f === 'todos' || t.dataset.cat === f;
        t.classList.toggle('hide', !on);
        if (on) visible.push(i);
      });
    })
  );
</script>

<style>
  .page-head { text-align: center; margin-bottom: 2rem; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); margin: 0 0 0.4rem; }
  .filters { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; padding: 0.4rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); }
  .chip {
    border: 0; cursor: pointer; padding: 0.55rem 1.1rem; border-radius: 999px; background: transparent;
    font: 800 0.95rem 'Nunito', sans-serif; color: var(--muted); transition: background 0.25s, color 0.25s;
  }
  .chip:hover { color: var(--accent-strong); }
  .chip[aria-pressed='true'] { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; }

  .masonry { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: clamp(190px, 24vw, 270px); grid-auto-flow: dense; gap: 1rem; }
  .tile { transition: opacity 0.8s var(--ease), transform 0.8s var(--ease), scale 0.4s var(--ease); }
  .tile.big { grid-column: span 2; }
  .tile.wide { grid-column: 1 / -1; }
  .tile.wide img { object-position: 50% 80%; }
  .tile.hide { display: none; }
  .open {
    position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; cursor: zoom-in;
    border-radius: var(--radius); overflow: hidden; background: var(--surface); box-shadow: var(--shadow);
  }
  .open img { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale 0.6s var(--ease), filter 0.4s; }
  .open:hover img, .open:focus-visible img { scale: 1.08; }
  .overlay {
    position: absolute; inset: auto 0 0 0; display: flex; flex-direction: column; gap: 0.15rem; text-align: left;
    padding: 2.5rem 1.1rem 1rem; color: #fff; background: linear-gradient(transparent, rgba(20, 8, 26, 0.85));
    translate: 0 30%; opacity: 0; transition: translate 0.4s var(--ease), opacity 0.4s;
  }
  .overlay b { font: 700 1.2rem 'Fredoka', sans-serif; }
  .overlay small { font-size: 0.9rem; opacity: 0.9; }
  .open:hover .overlay, .open:focus-visible .overlay { translate: 0 0; opacity: 1; }
  .zoom {
    position: absolute; top: 0.8rem; right: 0.8rem; width: 2.4rem; height: 2.4rem; display: grid; place-items: center;
    border-radius: 50%; background: rgba(255, 255, 255, 0.9); color: #2b1b24; font-size: 1.1rem; font-weight: 700;
    scale: 0.6; opacity: 0; transition: scale 0.3s var(--ease), opacity 0.3s;
  }
  .open:hover .zoom { scale: 1; opacity: 1; }

  .feature { margin-top: 4rem; display: grid; grid-template-columns: 1.35fr 1fr; gap: 1.2rem; align-items: stretch; }
  .michi-card { padding: 1rem; }
  .caption { text-align: center; margin: 0.5rem 0 0.2rem; color: var(--muted); }
  .promo { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 1.3rem; overflow: hidden; }
  .promo p { margin: 0; font-size: 1.1rem; max-width: 22rem; }
  .phone {
    position: relative; width: 150px; height: 290px; border-radius: 34px; padding: 9px;
    background: linear-gradient(145deg, #3f3f46, #0a0a0a); box-shadow: var(--shadow-lg), inset 0 0 0 2px #52525b;
    animation: phone 6s ease-in-out infinite; transform-style: preserve-3d;
  }
  @keyframes phone { 0%, 100% { transform: rotate(-6deg) translateY(0); } 50% { transform: rotate(4deg) translateY(-10px); } }
  .notch { position: absolute; top: 16px; left: 50%; translate: -50% 0; width: 46px; height: 13px; border-radius: 10px; background: #000; z-index: 1; }
  .screen {
    height: 100%; border-radius: 26px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.3rem;
    background: radial-gradient(circle at 30% 20%, #f472b6, transparent 60%), radial-gradient(circle at 70% 80%, #8b5cf6, transparent 60%), #1e1b4b;
    color: #fff;
  }
  .screen b { font: 700 1.3rem 'Fredoka', sans-serif; }
  .screen small { font-size: 0.65rem; opacity: 0.85; }
  .apple { width: 26px; height: 30px; background: #fff; border-radius: 50% 50% 45% 45% / 55% 55% 45% 45%; position: relative; }
  .apple::after { content: ''; position: absolute; top: -9px; left: 12px; width: 8px; height: 10px; background: #fff; border-radius: 0 100% 0 100%; }
  .logo { position: relative; display: block; border-radius: 50%; transition: transform 0.3s var(--ease); }
  .logo img { display: block; position: relative; z-index: 1; }
  .logo:hover { transform: rotate(-10deg) scale(1.12); }
  .pulse { position: absolute; inset: 0; border-radius: 50%; background: #0a66c2; animation: pulse 2s ease-out infinite; }
  @keyframes pulse { to { transform: scale(1.6); opacity: 0; } }

  .lightbox {
    width: min(1000px, 94vw); max-width: none; max-height: 94vh; padding: 0; border: 0; background: transparent;
    overflow: visible; color: #fff;
  }
  .lightbox::backdrop { background: rgba(15, 5, 20, 0.85); backdrop-filter: blur(8px); }
  .lightbox[open] { animation: lb 0.35s var(--ease); display: flex; align-items: center; gap: 0.6rem; }
  @keyframes lb { from { opacity: 0; transform: scale(0.94); } }
  .lightbox figure { margin: 0; flex: 1; min-width: 0; }
  .lightbox img { display: block; width: 100%; height: auto; max-height: 76vh; object-fit: contain; border-radius: 20px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); }
  .lightbox figcaption { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; margin-top: 0.9rem; text-align: center; }
  .lightbox figcaption b { font: 700 1.4rem 'Fredoka', sans-serif; }
  .lightbox figcaption span { opacity: 0.85; }
  .lightbox figcaption small { opacity: 0.6; margin-top: 0.2rem; }
  .lb-nav, .lb-close {
    display: grid; place-items: center; border: 0; cursor: pointer; border-radius: 50%;
    background: rgba(255, 255, 255, 0.15); color: #fff; transition: background 0.2s, transform 0.2s;
  }
  .lb-nav { width: 3rem; height: 3rem; font-size: 2rem; line-height: 1; flex-shrink: 0; }
  .lb-nav:hover, .lb-close:hover { background: var(--accent); transform: scale(1.08); }
  .lb-close { position: absolute; top: -3.2rem; right: 0; width: 2.6rem; height: 2.6rem; font-size: 1.1rem; }

  @media (max-width: 820px) {
    .masonry { grid-template-columns: repeat(2, 1fr); }
    .feature { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .masonry { grid-template-columns: 1fr; }
    .tile.big, .tile.wide { grid-column: auto; }
    .masonry { grid-auto-rows: auto; }
    .open img { height: auto; aspect-ratio: 800 / 520; }
    .overlay { translate: 0 0; opacity: 1; padding-top: 1.8rem; }
    .overlay small { display: none; }
    .chip { padding: 0.5rem 0.75rem; font-size: 0.88rem; }
    .lb-nav { position: absolute; bottom: -4rem; }
    .lb-nav.prev { left: 25%; }
    .lb-nav.next { right: 25%; }
  }
</style>
