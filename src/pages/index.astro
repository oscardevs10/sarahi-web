---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const intereses = [
  { icon: '😴', title: 'Dormir', text: 'Una buena siesta arregla cualquier día.' },
  { icon: '🍕', title: 'Comer', text: 'Probar comida nueva (y repetir la favorita).' },
  { icon: '🎧', title: 'Música', text: 'Playlists para estudiar, caminar y todo lo demás.' },
  { icon: '💻', title: 'Páginas web', text: 'Aprendiendo HTML y CSS en el CBTIS.' },
];
---
<Layout title="Inicio">
  <section class="hero card">
    <img class="avatar" src={`${base}img/avatar.svg`} alt="Ilustración de Sarahi" width="220" height="220" />
    <div>
      <p class="eyebrow">👋 Bienvenid@</p>
      <h1>Hola, soy <span class="hl">Sarahi</span></h1>
      <p class="lead">Estudio en el <strong>CBTIS</strong> y me gusta dormir y comer.</p>
      <div class="actions">
        <a class="btn" href="#intereses">Ir a mis intereses ↓</a>
        <a class="btn ghost" href={`${base}galeria`}>Ver galería</a>
      </div>
    </div>
  </section>

  <section id="intereses" class="intereses">
    <h2>Mis intereses</h2>
    <ul class="grid">
      {intereses.map((i) => (
        <li class="card item">
          <span class="icon" aria-hidden="true">{i.icon}</span>
          <h3>{i.title}</h3>
          <p>{i.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 2rem; align-items: center; }
  .avatar { border-radius: 28px; box-shadow: var(--shadow); width: 220px; height: 220px; }
  .eyebrow { margin: 0; font-weight: 700; color: var(--pink-700); letter-spacing: 0.03em; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin: 0.3rem 0 0.6rem; }
  .hl { color: var(--pink-500); }
  .lead { font-size: 1.2rem; color: var(--muted); margin: 0 0 1.4rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .intereses { margin-top: 3.5rem; scroll-margin-top: 5rem; }
  .intereses h2 { font-size: 2rem; margin: 0 0 1.25rem; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .item { padding: 1.4rem; transition: transform 0.2s; }
  .item:hover { transform: translateY(-4px); }
  .icon { font-size: 2.2rem; }
  .item h3 { margin: 0.5rem 0 0.25rem; font-size: 1.25rem; }
  .item p { margin: 0; color: var(--muted); }

  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .avatar { width: 160px; height: 160px; }
    .actions { justify-content: center; }
  }
</style>
