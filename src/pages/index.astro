---
import Layout from '../layouts/Layout.astro';
import Avatar from '../components/Avatar.astro';
const base = import.meta.env.BASE_URL;

const roles = ['estudiante del CBTIS', 'profesional de la siesta', 'experta en comer', 'futura diseñadora web'];

const stats = [
  { n: '9h', l: 'de sueño ideal', i: '😴' },
  { n: '∞', l: 'antojos al día', i: '🍕' },
  { n: '0', l: 'ganas de madrugar', i: '⏰' },
];

const intereses = [
  { icon: '😴', title: 'Dormir', text: 'Una buena siesta arregla cualquier día. Mi superpoder: dormirme en 3 minutos.', level: 100, color: '#8b5cf6' },
  { icon: '🍕', title: 'Comer', text: 'Tacos, pizza, sushi, pan dulce... no discrimino ningún antojo.', level: 98, color: '#f59e0b' },
  { icon: '🎧', title: 'Música', text: 'Playlists para estudiar, caminar, bañarme y todo lo demás.', level: 85, color: '#0ea5e9' },
  { icon: '💻', title: 'Páginas web', text: 'Aprendiendo HTML, CSS y ahora Astro en el CBTIS.', level: 72, color: '#ec4f7f' },
];

const dia = [
  { h: '07:00', t: 'Clases en el CBTIS', d: 'A regañadientes, pero con café.', e: '📚' },
  { h: '14:00', t: 'La comida', d: 'El mejor momento del día. Sin discusión.', e: '🌮' },
  { h: '16:00', t: 'Siesta sagrada', d: 'No molestar. En serio.', e: '💤' },
  { h: '19:00', t: 'Tarea + música', d: 'Con la playlist perfecta todo sale.', e: '🎶' },
  { h: '21:00', t: 'Cena y series', d: 'Un capítulo más... y otro.', e: '🍿' },
  { h: '23:00', t: 'A dormir', d: 'Para repetirlo mañana.', e: '🌙' },
];
---
<Layout title="Inicio">
  <section class="hero">
    <div class="hero-text">
      <span class="kicker reveal">👋 ¡Hola, bienvenid@!</span>
      <h1 class="reveal" style="--d:.08s">Hola, soy <span class="grad-text">Sarahi</span></h1>
      <p class="role reveal" style="--d:.16s">
        Soy <span class="typed" data-words={JSON.stringify(roles)}>{roles[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="lead reveal" style="--d:.24s">Estudio en el <strong>CBTIS</strong> y me gusta <mark>dormir</mark> y <mark class="m2">comer</mark>. Este es mi rinconcito en internet. ✨</p>
      <div class="actions reveal" style="--d:.32s">
        <a class="btn" href="#intereses">Ir a mis intereses ↓</a>
        <a class="btn ghost" href={`${base}galeria`}>🎨 Ver galería</a>
      </div>
      <ul class="stats reveal" style="--d:.4s">
        {stats.map((s) => (
          <li><span class="si" aria-hidden="true">{s.i}</span><b>{s.n}</b><small>{s.l}</small></li>
        ))}
      </ul>
    </div>

    <div class="hero-art reveal" style="--d:.15s">
      <div class="ring" aria-hidden="true"></div>
      <button class="avatar-frame" type="button" id="avatar-btn" aria-label="Saludar a Sarahi">
        <Avatar />
      </button>
      <span class="sticker s1" aria-hidden="true">🍩</span>
      <span class="sticker s2" aria-hidden="true">💤</span>
      <span class="sticker s3" aria-hidden="true">🎧</span>
      <span class="sticker s4" aria-hidden="true">🌮</span>
      <span class="tag">CBTIS 🎓</span>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <span>😴 DORMIR ✦ 🍕 COMER ✦ 🎧 MÚSICA ✦ 💻 HTML & CSS ✦ 🐱 MICHI ✦ 🌮 TACOS ✦ 🎨 DIBUJAR ✦&nbsp;</span>
      ))}
    </div>
  </div>

  <section id="intereses" class="block">
    <div class="head reveal">
      <span class="kicker">💖 Lo que me hace feliz</span>
      <h2 class="section-title">Mis intereses</h2>
      <p class="section-sub">Ordenados científicamente por nivel de pasión.</p>
    </div>
    <ul class="grid">
      {intereses.map((i, idx) => (
        <li class="card item reveal" style={`--d:${idx * 0.08}s; --c:${i.color}`}>
          <span class="icon" aria-hidden="true">{i.icon}</span>
          <h3>{i.title}</h3>
          <p>{i.text}</p>
          <div class="meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={i.level} aria-label={`Nivel de pasión por ${i.title}`}>
            <span style={`--w:${i.level}%`}></span>
          </div>
          <small class="lvl">Nivel de pasión: <b>{i.level}%</b></small>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <div class="head reveal">
      <span class="kicker">🗓️ Rutina oficial</span>
      <h2 class="section-title">Mi día ideal</h2>
      <p class="section-sub">Spoiler: gira alrededor de comer y dormir.</p>
    </div>
    <ol class="timeline">
      {dia.map((x, idx) => (
        <li class="reveal" style={`--d:${idx * 0.06}s`}>
          <span class="dot" aria-hidden="true">{x.e}</span>
          <div class="card tl-card">
            <time>{x.h}</time>
            <h3>{x.t}</h3>
            <p>{x.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="block quote-wrap reveal">
    <figure class="card quote">
      <blockquote>“Primero como, luego duermo, y después ya veo si existo.”</blockquote>
      <figcaption>— Sarahi, filósofa de la siesta</figcaption>
    </figure>
  </section>

  <section class="cta card reveal">
    <div>
      <h2>¿Quieres ver mis dibujos? 🎨</h2>
      <p>Montañas, playas, ciudades de noche y a Michi, la mascota del grupo.</p>
    </div>
    <div class="cta-actions">
      <a class="btn" href={`${base}galeria`}>Ir a la galería →</a>
      <a class="btn ghost" href={`${base}contacto`}>💌 Escríbeme</a>
    </div>
  </section>
</Layout>

<script>
  // Texto que se escribe solo
  const el = document.querySelector<HTMLElement>('.typed');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let w = 0, i = words[0].length, del = true;
    const tick = () => {
      const word = words[w];
      el.textContent = word.slice(0, i);
      let wait = del ? 40 : 80;
      if (del && i === 0) { del = false; w = (w + 1) % words.length; wait = 300; }
      else if (!del && i === words[w].length) { del = true; wait = 1800; }
      else i += del ? -1 : 1;
      setTimeout(tick, wait);
    };
    setTimeout(tick, 2200);
  }

  // Saludo con confeti al tocar el avatar
  const btn = document.getElementById('avatar-btn');
  btn?.addEventListener('click', () => {
    btn.classList.remove('wave');
    void btn.offsetWidth;
    btn.classList.add('wave');
    const emojis = ['🎉', '💖', '✨', '🍕', '😴', '🌸'];
    for (let k = 0; k < 16; k++) {
      const s = document.createElement('span');
      s.className = 'confetti';
      s.textContent = emojis[k % emojis.length];
      const a = (Math.PI * 2 * k) / 16;
      s.style.setProperty('--x', Math.cos(a) * (120 + Math.random() * 60) + 'px');
      s.style.setProperty('--y', Math.sin(a) * (120 + Math.random() * 60) + 'px');
      btn.parentElement!.appendChild(s);
      setTimeout(() => s.remove(), 1100);
    }
  });
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 3rem; align-items: center; min-height: min(calc(100vh - 170px), 720px); padding: 1rem 0 2rem; }
  h1 { font-size: clamp(2.8rem, 8vw, 5.2rem); margin: 0 0 0.5rem; font-weight: 700; }
  .role { font-size: clamp(1.15rem, 2.6vw, 1.5rem); font-weight: 800; margin: 0 0 1rem; color: var(--ink); min-height: 1.6em; }
  .typed { color: var(--accent-strong); }
  .caret { display: inline-block; width: 3px; height: 1.1em; background: var(--accent); margin-left: 3px; vertical-align: -0.15em; animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .lead { font-size: 1.15rem; color: var(--muted); margin: 0 0 1.6rem; max-width: 34rem; }
  mark { background: linear-gradient(transparent 55%, color-mix(in srgb, var(--accent-2) 40%, transparent) 55%); color: inherit; padding: 0 0.1em; }
  mark.m2 { background: linear-gradient(transparent 55%, color-mix(in srgb, var(--accent-3) 50%, transparent) 55%); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .stats { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .stats li {
    display: grid; grid-template-columns: auto 1fr; column-gap: 0.55rem; align-items: center;
    padding: 0.6rem 1rem; border-radius: 18px; background: var(--surface); border: 1px solid var(--border);
  }
  .si { grid-row: span 2; font-size: 1.5rem; }
  .stats b { font: 700 1.3rem/1 'Fredoka', sans-serif; }
  .stats small { color: var(--muted); font-weight: 700; font-size: 0.8rem; line-height: 1.2; }

  .hero-art { position: relative; display: grid; place-items: center; aspect-ratio: 1; max-width: 440px; width: 100%; justify-self: center; }
  .ring {
    position: absolute; inset: 4%; border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), var(--accent-2), var(--accent-3), var(--accent-4), var(--accent));
    animation: spin 12s linear infinite; filter: blur(2px); opacity: 0.9;
  }
  .ring::after { content: ''; position: absolute; inset: 10px; border-radius: 50%; background: var(--bg-2); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .avatar-frame {
    position: relative; width: 74%; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 44px;
    filter: drop-shadow(0 25px 35px rgba(29, 78, 216, 0.35)); animation: bob 5s ease-in-out infinite;
    transition: transform 0.3s var(--ease);
  }
  .avatar-frame:hover { transform: scale(1.04) rotate(-2deg); }
  .avatar-frame.wave { animation: wave 0.7s var(--ease); }
  @keyframes bob { 50% { translate: 0 -12px; } }
  @keyframes wave { 25% { transform: rotate(-8deg) scale(1.05); } 50% { transform: rotate(6deg) scale(1.08); } 75% { transform: rotate(-3deg); } }
  .sticker { position: absolute; font-size: clamp(1.8rem, 4vw, 2.6rem); filter: drop-shadow(0 8px 10px rgba(0,0,0,.18)); animation: bob 4s ease-in-out infinite; }
  .s1 { top: 4%; left: 8%; animation-delay: -1s; }
  .s2 { top: 10%; right: 4%; animation-delay: -2s; }
  .s3 { bottom: 12%; left: 0; animation-delay: -3s; }
  .s4 { bottom: 4%; right: 12%; animation-delay: -0.5s; }
  .tag {
    position: absolute; bottom: 20%; right: -2%; padding: 0.45rem 0.9rem; border-radius: 999px; rotate: 8deg;
    background: var(--surface-solid); color: var(--ink); font-weight: 800; box-shadow: var(--shadow); border: 1px solid var(--border);
  }
  .hero-art :global(.confetti) {
    position: absolute; top: 50%; left: 50%; font-size: 1.5rem; pointer-events: none; z-index: 5;
    animation: burst 1s var(--ease) forwards;
  }
  @keyframes burst {
    from { transform: translate(-50%, -50%) scale(0.3); opacity: 1; }
    to { transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(1.2) rotate(40deg); opacity: 0; }
  }

  .marquee {
    margin: 1rem -1rem 0; overflow: hidden; padding: 0.9rem 0; rotate: -1.5deg;
    background: linear-gradient(90deg, var(--accent), var(--accent-2)); color: #fff;
    font: 700 1.1rem 'Fredoka', sans-serif; letter-spacing: 0.06em; box-shadow: var(--shadow);
  }
  .track { display: flex; width: max-content; animation: marquee 28s linear infinite; }
  .track span { white-space: nowrap; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .block { margin-top: 5rem; scroll-margin-top: 6rem; }
  .head { text-align: center; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.1rem; }
  .item { position: relative; overflow: hidden; padding: 1.5rem; transition: translate 0.35s var(--ease), rotate 0.35s var(--ease), box-shadow 0.35s, opacity 0.8s var(--ease), transform 0.8s var(--ease); }
  .item::before {
    content: ''; position: absolute; width: 140px; height: 140px; border-radius: 50%; top: -60px; right: -50px;
    background: var(--c); opacity: 0.15; transition: transform 0.5s var(--ease);
  }
  .item:hover { translate: 0 -8px; rotate: -0.6deg; box-shadow: var(--shadow-lg); }
  .item:hover::before { transform: scale(1.6); }
  .icon {
    display: grid; place-items: center; width: 3.4rem; height: 3.4rem; font-size: 1.9rem; border-radius: 16px;
    background: color-mix(in srgb, var(--c) 18%, transparent);
  }
  .item h3 { margin: 0.9rem 0 0.3rem; font-size: 1.35rem; }
  .item p { margin: 0 0 1rem; color: var(--muted); font-size: 0.97rem; }
  .meter { height: 10px; border-radius: 999px; background: color-mix(in srgb, var(--c) 15%, transparent); overflow: hidden; }
  .meter span { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--c); transition: width 1.4s var(--ease) 0.3s; }
  .item.in .meter span, :global(html:not(.js)) .meter span { width: var(--w); }
  .lvl { display: block; margin-top: 0.4rem; color: var(--muted); font-weight: 700; }
  .lvl b { color: var(--c); }

  .timeline { list-style: none; padding: 0; margin: 0 auto; max-width: 720px; position: relative; }
  .timeline::before {
    content: ''; position: absolute; left: 1.55rem; top: 0.5rem; bottom: 0.5rem; width: 4px; border-radius: 4px;
    background: linear-gradient(var(--accent), var(--accent-2), var(--accent-3));
  }
  .timeline li { position: relative; display: grid; grid-template-columns: 3.2rem 1fr; gap: 1rem; margin-bottom: 1rem; }
  .dot {
    position: relative; z-index: 1; display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border-radius: 50%;
    background: var(--surface-solid); border: 3px solid var(--accent); font-size: 1.4rem; box-shadow: var(--shadow);
  }
  .tl-card { padding: 1rem 1.3rem; transition: translate 0.3s var(--ease); }
  .tl-card:hover { translate: 6px 0; }
  .tl-card time { font: 700 0.85rem 'Fredoka', sans-serif; color: var(--accent-strong); background: var(--surface-2); padding: 0.15rem 0.6rem; border-radius: 999px; }
  .tl-card h3 { margin: 0.45rem 0 0.15rem; font-size: 1.2rem; }
  .tl-card p { margin: 0; color: var(--muted); }

  .quote { position: relative; text-align: center; padding: 3rem 2rem 2.2rem; max-width: 820px; margin: 0 auto; overflow: hidden; }
  .quote::before { content: '“'; position: absolute; top: -2.5rem; left: 1rem; font: 700 11rem 'Fredoka', sans-serif; color: var(--accent); opacity: 0.15; }
  .quote blockquote { margin: 0; font: 700 clamp(1.7rem, 4.5vw, 2.6rem)/1.2 'Caveat', cursive; color: var(--ink); }
  .quote figcaption { margin-top: 1rem; color: var(--muted); font-weight: 700; }

  .cta {
    margin-top: 5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 2.2rem; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 22%, var(--surface)), color-mix(in srgb, var(--accent-2) 22%, var(--surface)));
  }
  .cta h2 { margin: 0 0 0.3rem; font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .cta p { margin: 0; color: var(--muted); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; text-align: center; min-height: 0; gap: 1.5rem; padding-top: 0; }
    .hero-art { order: -1; max-width: 320px; }
    .lead { margin-inline: auto; }
    .actions, .stats { justify-content: center; }
    .stats li { text-align: left; }
  }
</style>
