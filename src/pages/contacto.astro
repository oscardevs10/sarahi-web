---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const email = 'Sanchez@gmail.com';
const faq = [
  { q: '¿Respondes rápido?', a: 'Depende. Si estoy despierta, sí. Si es hora de la siesta... mañana. 😴' },
  { q: '¿Aceptas invitaciones a comer?', a: '¡Siempre! Tacos, pizza o sushi son respuestas correctas. 🌮' },
  { q: '¿Dónde aprendiste a hacer páginas web?', a: 'En el CBTIS, con mucha práctica y la ayuda de MDN Web Docs. 💻' },
];
---
<Layout title="Contacto" description="Escríbele a Sarahi: correo, formulario y preguntas frecuentes.">
  <header class="page-head">
    <span class="kicker reveal">💌 Hablemos</span>
    <h1 class="reveal" style="--d:.06s"><span class="grad-text">Contacto</span></h1>
    <p class="section-sub reveal" style="--d:.12s">¿Quieres decirme algo, invitarme a comer o recomendarme una canción? ¡Escríbeme!</p>
  </header>

  <div class="layout">
    <aside class="side">
      <div class="card info reveal">
        <h2>Encuéntrame aquí</h2>
        <div class="row">
          <a class="link" href={`mailto:${email}`}>
            <span class="ic" style="--c:#ec4f7f" aria-hidden="true">✉️</span>
            <span><small>Escríbeme a</small>{email}</span>
          </a>
          <button type="button" class="copy" id="copy" data-email={email} aria-label="Copiar correo">📋</button>
        </div>
        <a class="link" href="https://developer.mozilla.org/es/" target="_blank" rel="noopener">
          <span class="ic" style="--c:#0ea5e9" aria-hidden="true">📚</span>
          <span><small>Más información en</small>MDN Web Docs ↗</span>
        </a>
        <div class="status">
          <span class="led" aria-hidden="true"></span>
          <span id="status-text">Probablemente despierta</span>
        </div>
      </div>

      <div class="card faq reveal" style="--d:.08s">
        <h2>Preguntas frecuentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </aside>

    <form class="card form reveal" id="form" style="--d:.12s" novalidate>
      <h2>Mándame un mensaje</h2>
      <label>
        <span>Tu nombre</span>
        <input name="nombre" type="text" placeholder="¿Cómo te llamas?" required autocomplete="name" />
      </label>
      <fieldset>
        <legend>¿De qué se trata?</legend>
        <div class="options">
          <label class="opt"><input type="radio" name="tema" value="Saludo" checked /><span>👋 Saludo</span></label>
          <label class="opt"><input type="radio" name="tema" value="Invitación a comer" /><span>🍕 A comer</span></label>
          <label class="opt"><input type="radio" name="tema" value="Recomendación" /><span>🎧 Música</span></label>
          <label class="opt"><input type="radio" name="tema" value="Tarea" /><span>📚 Tarea</span></label>
        </div>
      </fieldset>
      <label>
        <span>Mensaje</span>
        <textarea name="mensaje" rows="5" maxlength="500" placeholder="Escribe aquí tu mensaje..." required></textarea>
        <small class="counter" id="counter">0 / 500</small>
      </label>
      <p class="error" id="error" role="alert" hidden>Escribe tu nombre y un mensaje, porfa. 🙏</p>
      <button class="btn send" type="submit">Enviar mensaje <span aria-hidden="true">🚀</span></button>
      <p class="note">Se abrirá tu app de correo con el mensaje listo.</p>
    </form>
  </div>

  <div class="back reveal">
    <a class="btn ghost" href={base}>← Volver al inicio</a>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</Layout>

<script define:vars={{ email }}>
  const toast = document.getElementById('toast');
  let tt;
  const say = (msg) => {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(tt);
    tt = setTimeout(() => toast.classList.remove('show'), 2200);
  };

  document.getElementById('copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      say('✅ Correo copiado');
    } catch {
      say('No se pudo copiar 😅');
    }
  });

  // Estado según la hora
  const h = new Date().getHours();
  const st = document.getElementById('status-text');
  const led = document.querySelector('.led');
  if (h >= 23 || h < 7) { st.textContent = 'Durmiendo... responde mañana 😴'; led.classList.add('off'); }
  else if (h >= 16 && h < 17) { st.textContent = 'En plena siesta 💤'; led.classList.add('off'); }
  else if (h >= 14 && h < 16) st.textContent = 'Comiendo, pero sí contesta 🌮';
  else st.textContent = 'Despierta y lista para contestar ✨';

  const form = document.getElementById('form');
  const ta = form.querySelector('textarea');
  const counter = document.getElementById('counter');
  const err = document.getElementById('error');
  ta.addEventListener('input', () => (counter.textContent = `${ta.value.length} / 500`));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const nombre = String(d.get('nombre') || '').trim();
    const mensaje = String(d.get('mensaje') || '').trim();
    if (!nombre || !mensaje) {
      err.hidden = false;
      form.classList.remove('shake');
      void form.offsetWidth;
      form.classList.add('shake');
      return;
    }
    err.hidden = true;
    const subject = `${d.get('tema')} de ${nombre}`;
    location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(mensaje + '\n\n— ' + nombre)}`;
    say('🚀 ¡Abriendo tu correo!');
  });
</script>

<style>
  .page-head { text-align: center; margin-bottom: 2.2rem; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); margin: 0 0 0.4rem; }
  .section-sub { max-width: 36rem; margin-inline: auto; }
  h2 { font-size: 1.4rem; margin: 0 0 1rem; }
  .layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.2rem; align-items: start; }
  .side { display: grid; gap: 1.2rem; }

  .info { display: grid; gap: 0.75rem; }
  .row { display: flex; gap: 0.5rem; }
  .row .link { flex: 1; min-width: 0; }
  .link {
    display: flex; align-items: center; gap: 0.9rem; padding: 0.9rem 1rem; border-radius: 18px;
    background: var(--surface-solid); border: 1px solid var(--border); text-decoration: none; color: var(--ink);
    font-weight: 800; word-break: break-word; transition: translate 0.2s var(--ease), border-color 0.2s;
  }
  .link:hover { translate: 4px 0; border-color: var(--accent); }
  .link small { display: block; font-weight: 700; color: var(--muted); font-size: 0.8rem; }
  .ic { display: grid; place-items: center; flex-shrink: 0; width: 2.8rem; height: 2.8rem; border-radius: 14px; font-size: 1.4rem; background: color-mix(in srgb, var(--c) 18%, transparent); }
  .copy {
    flex-shrink: 0; width: 3.4rem; border-radius: 18px; border: 1px solid var(--border); background: var(--surface-solid);
    font-size: 1.3rem; cursor: pointer; transition: transform 0.2s, border-color 0.2s;
  }
  .copy:hover { transform: scale(1.06); border-color: var(--accent); }
  .status { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.9rem; border-radius: 999px; background: var(--surface-2); font-weight: 700; font-size: 0.92rem; color: var(--muted); }
  .led { width: 10px; height: 10px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 #22c55e; animation: led 1.8s infinite; }
  .led.off { background: #a78bfa; animation: none; }
  @keyframes led { 70% { box-shadow: 0 0 0 8px transparent; } }

  .faq details { border-top: 1px solid var(--border); }
  .faq details:first-of-type { border-top: 0; }
  .faq summary {
    list-style: none; cursor: pointer; padding: 0.85rem 0; font-weight: 800; display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font: 700 1.4rem/1 'Fredoka', sans-serif; color: var(--accent); transition: rotate 0.3s var(--ease); }
  .faq details[open] summary::after { rotate: 45deg; }
  .faq details p { margin: 0 0 0.9rem; color: var(--muted); }

  .form { display: grid; gap: 1rem; }
  .form.shake { animation: shake 0.4s; }
  @keyframes shake { 25% { translate: -8px 0; } 50% { translate: 8px 0; } 75% { translate: -4px 0; } }
  .form > label, fieldset { display: grid; gap: 0.4rem; font-weight: 800; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 800; margin-bottom: 0.4rem; padding: 0; }
  input[type='text'], textarea {
    width: 100%; padding: 0.85rem 1rem; border-radius: 16px; border: 2px solid var(--border);
    background: var(--surface-solid); color: var(--ink); font: 600 1rem 'Nunito', sans-serif; resize: vertical;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input[type='text']:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
  ::placeholder { color: var(--muted); opacity: 0.7; }
  .options { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt span {
    display: inline-block; padding: 0.5rem 0.95rem; border-radius: 999px; border: 2px solid var(--border);
    background: var(--surface-solid); cursor: pointer; font-weight: 800; font-size: 0.92rem; transition: all 0.2s;
  }
  .opt:hover span { border-color: var(--accent); }
  .opt input:checked + span { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border-color: transparent; }
  .opt input:focus-visible + span { outline: 3px solid var(--accent-2); outline-offset: 2px; }
  .counter { justify-self: end; color: var(--muted); font-weight: 700; }
  .error { margin: 0; padding: 0.6rem 0.9rem; border-radius: 12px; background: #fee2e2; color: #991b1b; font-weight: 700; }
  .send { justify-self: start; font-size: 1.05rem; }
  .send:hover span { display: inline-block; animation: rocket 0.6s var(--ease); }
  @keyframes rocket { 50% { transform: translate(6px, -6px); } }
  .note { margin: -0.4rem 0 0; color: var(--muted); font-size: 0.85rem; }

  .back { text-align: center; margin-top: 2.5rem; }

  .toast {
    position: fixed; left: 50%; bottom: 1.5rem; translate: -50% 150%; z-index: 80;
    padding: 0.8rem 1.3rem; border-radius: 999px; background: var(--ink); color: var(--bg-3); font-weight: 800;
    box-shadow: var(--shadow-lg); transition: translate 0.4s var(--ease); pointer-events: none;
  }
  .toast.show { translate: -50% 0; }

  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }
</style>
